{
    "name": "statamic-addon/style-push",
    "version": "1.0.0",
    "description": "Vizuall Style Push — push per-partial CSS and JS to <head> and </body>",
    "type": "statamic-addon",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Vizuall\\StylePush\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Vizuall Style Push",
            "provider": "Vizuall\\StylePush\\AddonServiceProvider"
        },
        "laravel": {
            "providers": [
                "Vizuall\\StylePush\\AddonServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
